{
  "name": "rozenblum-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "description": "Plataforma full-stack Estudio Jurídico Rozenblum - V0.1 (Next.js + Express + MongoDB Atlas)",
  "scripts": {
    "build:shared": "pnpm --dir api/shared run build",
    "dev": "node api/scripts/dev.mjs all",
    "dev:web": "node api/scripts/dev.mjs web",
    "dev:api": "node api/scripts/dev.mjs api",
    "prebuild": "pnpm run build:shared",
    "build": "pnpm --dir api run build && pnpm --dir web run build",
    "start:api": "pnpm --dir api run start",
    "start:web": "pnpm --dir web run start",
    "pretypecheck": "pnpm run build:shared",
    "typecheck": "pnpm --dir api run typecheck && pnpm --dir web run typecheck",
    "pretest": "pnpm run build:shared",
    "test": "pnpm --dir api run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^11.0.4"
    }
  }
}
