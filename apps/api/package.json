{
  "name": "@rozenblum/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --out-dir dist --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed:atlas": "tsx src/seed/seedAtlas.ts",
    "test": "tsx --test src/tests/auth.test.ts src/tests/courses.test.ts src/tests/progress.test.ts"
  },
  "dependencies": {
    "@rozenblum/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
