# ─────────────────────────────────────────────────────────────
# Estudio Jurídico Rozenblum — API
# Copy to apps/api/.env (never commit the real file).
# ─────────────────────────────────────────────────────────────

# mock = datos en memoria (desarrollo/demo, sin Atlas)
# atlas = MongoDB Atlas (base definitiva). No hay fallback automático.
APP_MODE=mock
PORT=4000

# Sólo se usa cuando APP_MODE=atlas.
# Crear un usuario de BD con permisos mínimos (readWrite sobre esta base).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rozenblum

# Secreto para firmar los tokens de sesión demo. Usar 32+ caracteres aleatorios.
AUTH_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# Permite el login de demostración por rol. Desactivar en producción real.
ALLOW_DEMO_LOGIN=true
# Contraseña común de las cuentas demo (sólo se usa para sembrar/validar).
DEMO_PASSWORD=rozenblum-demo-2026

# Orígenes permitidos para el navegador (separados por coma).
CORS_ORIGIN=http://localhost:3000

# Datos de contacto que la API expone al frontend.
SUPPORT_EMAIL=soporte@estudio.com
CONTACT_WHATSAPP=5493621466878

# Estado de la integración de pagos (no guardar claves en la base).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Sólo para seed: si es true, no escribe nada cuando ya existen cursos.
SEED_SKIP_IF_POPULATED=false
