# API: Atlas es la única base de datos de la aplicación.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rozenblum
AUTH_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:3000
# Conexión local directa: no confiar en X-Forwarded-For. En producción,
# configurar según la cantidad real de proxies delante de la API.
TRUST_PROXY=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
WEB_PUBLIC_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
